{
  "name": "cone-visualization",
  "version": "1.0.0",
  "description": "A React application for visualizing a cone based on specified measurements.",
  "scripts": {
    "codegen": "orval --config orval.config.ts",
    "predev": "npm run codegen",
    "dev": "next dev --webpack",
    "prebuild": "npm run codegen",
    "build": "next build",
    "start": "npx serve@latest ./build -l 3000",
    "pretest": "npm run codegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@heroui/react": "^3.0.2",
    "@heroui/styles": "^3.0.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/react": "^19.1.11",
    "@types/react-calendar-heatmap": "^1.9.0",
    "@types/react-dom": "^19.1.7",
    "cone-editor": "file:../cone_editor",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-calendar-heatmap": "^1.10.0",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "orval": "^8.8.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
