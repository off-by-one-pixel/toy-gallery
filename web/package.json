{
  "name": "web",
  "version": "1.0.0",
  "description": "Toy Gallery web app \u2014 Next.js + HeroUI frontend that talks to the Django API.",
  "scripts": {
    "codegen": "orval --config orval.config.ts",
    "predev": "npm run codegen",
    "dev": "next dev --webpack",
    "prebuild": "npm run codegen",
    "build": "next build",
    "start": "npx serve@latest ./build -l 3000",
    "pretest": "npm run codegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@heroui/react": "^3.0.2",
    "@heroui/styles": "^3.0.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@tanstack/react-query": "^5.101.4",
    "@types/react": "^19.1.11",
    "@types/react-calendar-heatmap": "^1.9.0",
    "@types/react-dom": "^19.1.7",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "next-intl": "^4.13.0",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-calendar-heatmap": "^1.10.0",
    "react-dom": "^19.1.1",
    "toy-editor": "link:../toy-editor",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.102.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "happy-dom": "^20.11.13",
    "orval": "^8.8.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
