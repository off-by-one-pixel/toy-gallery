# Build context is the repo root, shared by both Dockerfiles:
#   - cone-visualization/Dockerfile (FE-only static server)
#   - Dockerfile                    (all-in-one Django + bundled FE export)

# Node / Next.js outputs
**/node_modules
**/.next
**/out
cone-visualization/build
cone-visualization/src/services/generated

# Python / Django local state (the all-in-one image installs deps fresh
# from pyproject.toml + uv.lock, so the local venv and dev DB are noise).
toy_gallery_be/.venv
toy_gallery_be/db.sqlite3
toy_gallery_be/staticfiles
toy_gallery_be/**/__pycache__
toy_gallery_be/**/*.pyc

# cone_editor is a submodule that gets built in stage 1 of the all-in-one
# Dockerfile — we need its source in the build context. Exclude only the
# build outputs and tooling state.
cone_editor/dist
cone_editor/.devcontainer

# Legacy sibling project not used by the Docker build
toy-svg-editor

# VCS / editor
.git
.gitignore
.vscode
.devcontainer

# Env and secrets
**/.env
**/.env.*
!**/.env.example

# Logs and OS cruft
**/*-debug.log*
.DS_Store
