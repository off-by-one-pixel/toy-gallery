# Build context is the repo root, shared by both Dockerfiles:
#   - web/Dockerfile (FE-only static server)
#   - Dockerfile                    (all-in-one Django + bundled FE export)

# Node / Next.js outputs
**/node_modules
**/.next
**/out
web/build
web/src/services/generated

# Python / Django local state (the all-in-one image installs deps fresh
# from pyproject.toml + uv.lock, so the local venv and dev DB are noise).
api/.venv
api/db.sqlite3
api/staticfiles
api/**/__pycache__
api/**/*.pyc

# toy-editor is a submodule that gets built in stage 1 of the all-in-one
# Dockerfile — we need its source in the build context. Exclude only the
# build outputs and tooling state.
toy-editor/dist
toy-editor/.devcontainer

# VCS / editor
.git
.gitignore
.vscode
.devcontainer

# Env and secrets
**/.env
**/.env.*
!**/.env.example

# Logs and OS cruft
**/*-debug.log*
.DS_Store
