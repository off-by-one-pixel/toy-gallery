{
  "name": "Toy Gallery (Full Stack)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../.."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "remoteEnv": {
    "TZ": "America/Toronto",
    "MANAGE_PY_PATH": "/workspace/api/manage.py"
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "Frontend (web)" },
    "8000": { "label": "Django Backend" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "batisteo.vscode-django",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "dsznajder.es7-react-js-snippets",
        "SonarSource.sonarlint-vscode",
        "charliermarsh.ruff",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/api/.venv/bin/python",
        "python.analysis.autoImportCompletions": true,
        "python.analysis.indexing": true,
        "ruff.importStrategy": "fromEnvironment",
        "ruff.interpreter": ["/workspace/api/.venv/bin/python"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "sonarlint.ls.vmargs": "-Xmx512m",
        "sonarlint.analysisExcludesStandalone": "**/node_modules/**,**/.venv/**,**/.next/**,**/dist/**,**/.pnpm-store/**",
        "js/ts.tsserver.maxMemory": 2048,
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.venv/**": true,
          "**/.next/**": true,
          "**/dist/**": true,
          "**/.pnpm-store/**": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/.venv": true,
          "**/.next": true,
          "**/dist": true,
          "**/.pnpm-store": true
        }
      }
    }
  },
  "postCreateCommand": "sudo corepack enable pnpm && cd /workspace/api && uv sync && cd /workspace && pnpm install && pnpm --filter toy-editor build && pre-commit install",
  "remoteUser": "vscode"
}
